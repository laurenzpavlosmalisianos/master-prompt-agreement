{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "checks": {
      "additionalProperties": {
        "additionalProperties": false,
        "properties": {
          "description": {
            "minLength": 1,
            "type": "string"
          },
          "subject": {
            "enum": [
              "framework",
              "project"
            ],
            "type": "string"
          }
        },
        "required": [
          "description",
          "subject"
        ],
        "type": "object"
      },
      "minProperties": 1,
      "type": "object"
    },
    "profiles": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "description": {
            "minLength": 1,
            "type": "string"
          },
          "extends": {
            "items": {
              "pattern": "^[a-z][a-z0-9-]*$",
              "type": "string"
            },
            "type": "array",
            "uniqueItems": true
          },
          "id": {
            "pattern": "^[a-z][a-z0-9-]*$",
            "type": "string"
          },
          "required_checks": {
            "items": {
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            "type": "array",
            "uniqueItems": true
          },
          "required_directories": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "type": "array",
            "uniqueItems": true
          },
          "required_files": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "type": "array",
            "uniqueItems": true
          },
          "subject": {
            "enum": [
              "framework",
              "project"
            ],
            "type": "string"
          }
        },
        "required": [
          "description",
          "id",
          "required_checks",
          "required_files",
          "subject"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "spec_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "spec_version",
    "checks",
    "profiles"
  ],
  "type": "object"
}
