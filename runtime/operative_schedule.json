{
  "schema_version": 1,
  "purpose": "routing-table-not-doctrine",
  "authority": "Selects Risk Levels, Evidence Scope levels, and Practice Guides. Does not override MSA, SOW, Task Orders, Practice Guides, or inspected evidence.",
  "authority_scope": {
    "allowed_effect": "select-runtime-routing",
    "selects": ["standards_of_care", "evidentiary_scopes", "practice_guides"],
    "does_not_override": [
      "master_service_agreement",
      "statement_of_work",
      "task_orders",
      "practice_guides",
      "inspected_evidence"
    ],
    "grants_permission": false,
    "grants_doctrine": false
  },
  "standards_of_care": [
    {
      "name": "fast",
      "rank": 1,
      "path": "runtime/standards_of_care.md",
      "description": "Small, local, reversible, low-risk work."
    },
    {
      "name": "standard",
      "rank": 2,
      "path": "runtime/standards_of_care.md",
      "description": "Default implementation work with normal verification."
    },
    {
      "name": "careful",
      "rank": 3,
      "path": "runtime/standards_of_care.md",
      "description": "Ambiguous, multi-file, user-facing, or hard-to-reverse work."
    },
    {
      "name": "adversarial",
      "rank": 4,
      "path": "runtime/standards_of_care.md",
      "description": "Security-sensitive, explicitly adversarial, or trust-boundary work."
    },
    {
      "name": "forensic",
      "rank": 5,
      "path": "runtime/standards_of_care.md",
      "description": "Incident, compromise, data-loss, or evidence-preservation work."
    }
  ],
  "evidentiary_scopes": [
    {
      "name": "patch",
      "rank": 1,
      "description": "Single patch or hunk level evidence."
    },
    {
      "name": "touched-files",
      "rank": 2,
      "description": "Only files changed by the task or diff."
    },
    {
      "name": "commit-series",
      "rank": 3,
      "description": "A sequence of related commits."
    },
    {
      "name": "feature-slice",
      "rank": 4,
      "description": "The feature path across modules and files."
    },
    {
      "name": "trust-boundary",
      "rank": 5,
      "description": "The full control path across trust or privilege boundaries."
    },
    {
      "name": "repo-slice",
      "rank": 6,
      "description": "A broad repository section or full incident surface."
    }
  ],
